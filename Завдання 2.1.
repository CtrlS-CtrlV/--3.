import functools, time

def cache(max_size=128):
    def decorator(func):
        _cache = {}
        @functools.wraps(func)
        def wrapper(*args):
            if args in _cache:
                print("cache hit")
                return _cache[args]
            print("cache miss")
            if len(_cache) >= max_size:
                _cache.pop(next(iter(_cache)))
            result = func(*args)
            _cache[args] = result
            return result
        wrapper.cache_info = lambda: {"size": len(_cache)}
        return wrapper
    return decorator

def log(level="INFO"):
    def decorator(func):
        @functools.wraps(func)
        def wrapper(*args, **kwargs):
            print(f"[{level}] Виклик {func.__name__}")
            start = time.time()
            try:
                res = func(*args, **kwargs)
                print(f"[{level}] {func.__name__} -> {res} (час: {time.time()-start:.4f}с)")
                return res
            except Exception as e:
                print(f"[ERROR] {e}")
                raise
        return wrapper
    return decorator

@cache(64)
def fib(n): return n if n < 2 else fib(n-1) + fib(n-2)

@log("DEBUG")
def divide(a, b): return a / b

if __name__ == "__main__":
    print(f"Fib(10): {fib(10)}")
    print(fib.cache_info())
    divide(10, 2)
